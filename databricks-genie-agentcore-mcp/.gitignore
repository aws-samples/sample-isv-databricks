# Generated at deploy time — holds the Cognito client secret, gateway/target/provider
# ARNs and the AWS account id. Never commit. The glob also covers
# gateway_config.json.tmp, which write_state leaves behind if a deploy is interrupted
# between the write and the rename, and which holds the same secret.
gateway_config.json*

# Written by `agentcore configure` / `agentcore deploy` — runtime/agent ARNs, ECR uri.
.bedrock_agentcore.yaml

# Build/staging artifacts written by the `agentcore` CLI.
.bedrock_agentcore/

# Written by generate_data.py — records the sample dataset it created so --drop
# only removes objects this sample made. No secrets, but local state. The glob covers
# seed_state.json.tmp, which write_seed_state leaves behind when a write fails or a run is
# interrupted before the rename.
seed_state.json*

# Written by secrets_setup.py — records the Secrets Manager secret it created (ARN + a
# created flag) so --delete only removes a secret this script made. No secret value, but
# local state.
secret_state.json

# Local secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
