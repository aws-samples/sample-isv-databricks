# Copy to .env and fill in your own values (or `export` them in your shell).
# All four Databricks values are required; see README.md for how to obtain each.

# Databricks workspace URL (no trailing slash)
DATABRICKS_HOST="https://dbc-xxxxxxxx-xxxx.cloud.databricks.com"

# Service principal OAuth (M2M) credentials
DATABRICKS_CLIENT_ID="<service-principal-application-id>"
DATABRICKS_CLIENT_SECRET="<oauth-m2m-secret>"

# Genie space the gateway will expose as an MCP tool
GENIE_SPACE_ID="<genie-space-id>"

# AWS region — must be the same for deploy.py and invoke.py
AWS_REGION="us-east-1"

# Optional: override the Bedrock model the local agent uses
# MODEL_ID="us.anthropic.claude-sonnet-4-20250514-v1:0"
