# Copy to .env and fill in your own values (or `export` them in your shell).
# All four Databricks values are required; see README.md for how to obtain each.

# Databricks workspace URL (no trailing slash)
DATABRICKS_HOST="https://dbc-xxxxxxxx-xxxx.cloud.databricks.com"

# Service principal OAuth (M2M) credentials
DATABRICKS_CLIENT_ID="<service-principal-application-id>"
DATABRICKS_CLIENT_SECRET="<oauth-m2m-secret>"

# Optional production path: keep the OAuth secret in AWS Secrets Manager instead of the
# plaintext above. Run `python secrets_setup.py` (once, with DATABRICKS_CLIENT_SECRET set),
# then set DATABRICKS_SECRET_ARN to the ARN it prints and remove DATABRICKS_CLIENT_SECRET.
# deploy.py then registers the credential provider as EXTERNAL and references this secret.
# DATABRICKS_SECRET_ARN="arn:aws:secretsmanager:us-east-1:<account>:secret:databricks-genie-agentcore/oauth-client-secret-abcde"
# DATABRICKS_SECRET_JSON_KEY="client_secret"   # key inside the secret JSON (default shown)
# DATABRICKS_SECRET_NAME="databricks-genie-agentcore/oauth-client-secret"  # name secrets_setup.py uses

# Genie space the gateway will expose as an MCP tool
GENIE_SPACE_ID="<genie-space-id>"

# AWS region — must be the same for deploy.py and invoke.py
AWS_REGION="us-east-1"

# Optional: override the Bedrock model the local agent uses
# MODEL_ID="global.anthropic.claude-sonnet-5"
